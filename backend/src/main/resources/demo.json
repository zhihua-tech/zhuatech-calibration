      "tolerance": 0.2
    }
  },
  {
    "op": "action",
    "target": "job",
    "action": "start",
    "data": {}
  },
  {
    "op": "create",
    "as": "point1",
    "module": "readings",
    "data": {
      "job": "$job.id",
      "point": "P1",
      "nominal": 10,
      "measured": 10.1
    }
  },
  {
    "op": "create",
    "as": "point2",
    "module": "readings",
    "data": {
      "job": "$job.id",
      "point": "P2",
      "nominal": 20,
      "measured": 20.4
    }
  },
  {
    "op": "action",
    "target": "job",
    "action": "evaluate",
    "data": {}
  },
  {
    "op": "action",
    "target": "job",
    "action": "approve",
    "data": {},
    "role": "reviewer"
  },
  {
    "op": "create",
    "as": "retest",
    "module": "jobs",
    "data": {
      "instrument": "$instrument.id",
      "standard": "$standard.id",
      "performedAt": "$today",
      "tolerance": 0.2
    }
  },
  {
    "op": "action",
    "target": "retest",
    "action": "start",
    "data": {}
  },
  {
    "op": "create",
    "as": "rp1",
    "module": "readings",
    "data": {
      "job": "$retest.id",
      "point": "P1",
      "nominal": 10,
      "measured": 10.1
