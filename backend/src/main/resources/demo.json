      "unit": "kPa",
      "cycleDays": 90,
      "dueDate": "$today"
    }
  },
  {
    "op": "create",
    "as": "badJob",
    "module": "jobs",
    "data": {
      "instrument": "$instrument.id",
      "standard": "$expired.id",
      "performedAt": "$today",
      "tolerance": 0.2
    }
  },
  {
    "op": "create",
    "as": "job",
    "module": "jobs",
