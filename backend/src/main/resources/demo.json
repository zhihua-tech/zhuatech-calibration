[
  {
    "op": "create",
    "as": "standard",
    "module": "standards",
    "data": {
      "name": "标准压力源",
      "certificate": "CAL-STD-001",
      "validUntil": "$today+30",
      "unit": "kPa"
    }
  },
  {
    "op": "create",
    "as": "expired",
    "module": "standards",
    "data": {
      "name": "过期标准压力源",
      "certificate": "CAL-EXPIRED",
      "validUntil": "$today-1",
      "unit": "kPa"
    }
  },
  {
    "op": "create",
    "as": "instrument",
    "module": "instruments",
    "data": {
      "name": "生产线压力表",
